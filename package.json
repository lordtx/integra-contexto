{
  "name": "integra-contexto",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de jogos interativos para transmissões ao vivo. Primeiro jogo: Integra Contexto.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:worker": "cd apps/worker && npm run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "seed:vocab": "tsx scripts/seed-vocabulary.ts",
    "seed:game": "tsx scripts/seed-game.ts",
    "poc": "tsx scripts/run-poc.ts"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}