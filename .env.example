# Required by the API and worker. Store the real values only in Coolify secrets.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=integra_contexto
POSTGRES_USER=integra
POSTGRES_PASSWORD=change-me

# BullMQ accepts a full Redis URL. Use rediss:// when the Redis service requires TLS.
REDIS_URL=redis://:change-me@redis:6379

API_PORT=3001

# Public browser configuration only: do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://ws.example.com

# The live connector must be implemented and enabled explicitly. Do not use a
# browser-exposed TikTok credential. The current PirateTok adapter is mock-only.
TIKTOK_CONNECTOR_ENABLED=false
