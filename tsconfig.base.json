{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2022"],
    "paths": {
      "@integra/database": ["./packages/database/src"],
      "@integra/types": ["./packages/types/src"],
      "@integra/tiktok": ["./packages/tiktok/src"],
      "@integra/game-engine": ["./packages/game-engine/src"],
      "@integra/realtime": ["./packages/realtime/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}