{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@integra/database": ["packages/database/src"],
      "@integra/types": ["packages/types/src"],
      "@integra/tiktok": ["packages/tiktok/src"],
      "@integra/game-engine": ["packages/game-engine/src"],
      "@integra/realtime": ["packages/realtime/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}